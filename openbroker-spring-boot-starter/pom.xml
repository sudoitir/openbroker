<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sudoitir</groupId>
        <artifactId>openbroker-parent</artifactId>
        <version>0.6.2-SNAPSHOT</version>
    </parent>

    <artifactId>openbroker-spring-boot-starter</artifactId>
    <name>OpenBroker Spring Boot starter</name>
    <description>Everything a Spring Boot application needs to use OpenBroker; add the drivers it uses.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-support</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The one place Spring is allowed (ADR-0027): the parent's ban is lifted here. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <configuration>
                            <rules combine.self="override">
                                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The starter is an empty jar, like Spring Boot's own starters. Central wants a sources jar and a javadoc
             jar next to it, so both are made empty; the javadoc plugin makes none for a jar with no sources. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration>
                            <forceCreation>true</forceCreation>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>empty-javadoc-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <forceCreation>true</forceCreation>
                                    <skipIfEmpty>false</skipIfEmpty>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
