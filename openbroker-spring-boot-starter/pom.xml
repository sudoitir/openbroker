<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sudoitir</groupId>
        <artifactId>openbroker-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>openbroker-spring-boot-starter</artifactId>
    <packaging>pom</packaging>
    <name>OpenBroker Spring Boot starter</name>
    <description>Everything a Spring Boot application needs to use OpenBroker; add the drivers it uses.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-support</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The one place Spring is allowed (ADR-0027): the parent's ban is lifted here. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <configuration>
                            <rules combine.self="override">
                                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
