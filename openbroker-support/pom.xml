<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sudoitir</groupId>
        <artifactId>openbroker-parent</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>

    <artifactId>openbroker-support</artifactId>
    <name>OpenBroker Support</name>
    <description>Shared implementation for drivers and consumers: the portable filter, polling notifications, rates.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The pinning test records JFR events; the module does not otherwise read jdk.jfr. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>jdk.jfr</arg>
                                <arg>--add-reads</arg>
                                <arg>io.github.sudoitir.openbroker.support=jdk.jfr</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-modules jdk.jfr --add-reads io.github.sudoitir.openbroker.support=jdk.jfr</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
