<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.sudoitir</groupId>
        <artifactId>openbroker-parent</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>

    <artifactId>openbroker-rabbitmq</artifactId>
    <name>OpenBroker driver for RabbitMQ</name>
    <description>Manages and moves messages on RabbitMQ through its management HTTP API and AMQP 0-9-1.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.sudoitir</groupId>
            <artifactId>openbroker-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-toxiproxy</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Mockito's inline mock maker is registered as an agent, not left to attach itself (a JDK that forbids that). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} is JaCoCo's agent, set when its prepare-agent has run. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <!-- The TCK and the broker integration tests (*IT) run against Testcontainers clusters. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <rabbitmq.image>${rabbitmq.image}</rabbitmq.image>
                        <toxiproxy.image>${toxiproxy.image}</toxiproxy.image>
                    </systemPropertyVariables>
                    <!-- The chaos TCK kills brokers and takes minutes per image: the chaos profile runs it. -->
                    <excludes>
                        <exclude>**/*ChaosIT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals><goal>report-aggregate</goal></goals>
                        <configuration>
                            <includeCurrentProject>true</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- The AMQP client is not JPMS-clean, so the driver is an automatic module. -->
                            <Automatic-Module-Name>io.github.sudoitir.openbroker.rabbitmq</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!-- No release contains this module yet; remove after 0.9.0. The api-check job would otherwise fail to resolve openbroker-rabbitmq:0.8.0. -->
        <japicmp.skip>true</japicmp.skip>
        <rabbitmq.image>rabbitmq:4.4.0-management</rabbitmq.image>
        <toxiproxy.image>ghcr.io/shopify/toxiproxy:2.12.0</toxiproxy.image>
    </properties>

    <profiles>
        <!-- The chaos TCK alone: ./mvnw -pl openbroker-rabbitmq verify -Pchaos [-Drabbitmq.image=...] -->
        <profile>
            <id>chaos</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*ChaosIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
